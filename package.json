{
  "name": "tigerlegs-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run --config vitest.unit.config.ts",
    "check:shared": "tsc -p tsconfig.shared.json",
    "audit:prod": "npm audit --omit=dev",
    "test:site": "playwright test --project=site",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "test:a11y": "vitest run --project storybook",
    "server": "node src/server/server.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "check:server": "tsc -p tsconfig.server.json",
    "test:features": "bddgen && playwright test --project=features",
    "dev:site": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:search": "pagefind --site dist && rm -rf public/pagefind && cp -R dist/pagefind public/pagefind",
    "build:js": "esbuild src/client/analysis-worker.ts --bundle --format=esm --platform=browser --outfile=public/analysis-worker.js",
    "build:css": "tailwindcss -i src/client/styles.css -o public/styles.css --minify",
    "build:samples": "node src/build-samples.ts",
    "build:docs": "node src/build-docs.ts",
    "build": "npm run build:js && npm run build:docs && npm run build:samples && npm run build:css && npm run build:site && npm run build:search",
    "dev": "npm run build:js && npm run build:docs && npm run build:samples && npm run build:css && ASTRO_TELEMETRY_DISABLED=1 astro dev --port 8123",
    "refs": "node src/format-references.ts",
    "tables": "node src/format-tables.ts",
    "headings": "node src/number-headings.ts",
    "diagrams": "plantuml -tsvg docs/diagrams/*.puml && node src/build-diagrams.ts",
    "icons": "node src/build-icons.ts",
    "mutate": "stryker run",
    "mutate:server": "stryker run stryker.server.config.json",
    "lint": "oxlint src test",
    "fmt": "oxfmt --write src test",
    "fmt:check": "oxfmt --check src test"
  },
  "dependencies": {
    "@ag-ui/core": "^1.0.4",
    "@astrojs/react": "^7.1.2",
    "@xmldom/xmldom": "^0.9.0",
    "astro": "^7.4.4",
    "i18next": "^27.2.2",
    "i18next-icu": "^2.7.1",
    "intl-messageformat": "^12.2.0",
    "leaflet": "^1.9.4",
    "marked": "^15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.58.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "^5.0.5",
    "esbuild": "^0.28.2",
    "fast-check": "^3.22.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pagefind": "^1.6.0",
    "playwright-bdd": "^9.2.1",
    "sharp": "^0.35.5",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "yaml": "^2.9.1",
    "qs": "^6.17.1",
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
