@startuml use-cases
left to right direction
title Sea-level use cases of TigerLegs

actor Athlete as athlete
actor Organiser as organiser
actor "Overpass API\n(OpenStreetMap)" as overpass << external >>
actor "Garmin Connect" as garmin << external >>

rectangle TigerLegs {
  usecase "Analyse a\nswimrun course" as UCA
  usecase "Prepare paddle\nrace notes" as UCB
  usecase "Verify a\ndesigned course" as UCC
  usecase "Follow the course\nmid-race (planned)" as UCD #line.dashed
}

athlete --> UCA
athlete --> UCB
athlete --> UCD
organiser --> UCA
organiser --> UCC

UCB .> UCA : <<include>>
UCC .> UCA : <<include>>

UCA --> overpass : terrain lookup\n(optional)
UCD --> garmin : course sync\n(planned)
@enduml
