---
import config from "../../deno.json";
interface Props {
  title: string;
  description: string;
  active: "extractor" | "about" | "guidebook" | "profile";
}
const { title, description, active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const languages = [
  { code: "en", flag: "🇬🇧", name: "English" },
  { code: "nl", flag: "🇳🇱", name: "Nederlands" },
  { code: "fr", flag: "🇫🇷", name: "Français" },
  { code: "de", flag: "🇩🇪", name: "Deutsch" },
];
const links = [
  { key: "extractor", href: base, text: "Extractorrr" },
  { key: "about", href: `${base}about.html`, text: "About" },
  { key: "guidebook", href: `${base}guidebook.html`, text: "Guidebook" },
];
---
<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="stylesheet" href={`${base}styles.css`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content="https://swimrun.group/tigerlegs/img/tigerlegs-social.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-stone-50 text-stone-800 antialiased">
    <header class="site-header">
      <div class="site-header-inner">
        <a href={base} class="site-brand"><img src={`${base}img/tigerlegs-logo-web.png`} alt="TigerLegs logo" /></a>
        <div class="site-header-tools">
          <span class="rounded bg-stone-950 px-2 py-0.5 text-xs font-semibold uppercase tracking-wider text-amber-400">Beta</span>
          <span id="app-version" class="text-xs text-stone-700">v{config.version}</span>
          <nav id="main-menu" aria-label="Main menu" class="site-menu">
            {links.map(link => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.text}</a>)}
          </nav>
          <select id="language-switch" aria-label="Language" class="lang-select">
            {languages.map(l => <option value={l.code} lang={l.code}>{l.flag} {l.code.toUpperCase()} · {l.name}</option>)}
          </select>
          <a id="profile-link" href={`${base}profile.html`} class="text-sm font-medium underline" aria-current={active === "profile" ? "page" : undefined}>Profile</a>
        </div>
      </div>
      <div class="site-tagline"><img src={`${base}img/tigerlegs-acronym-anim-dark.svg`} alt="TIGERLEGS: Terrain Informed Gpx ExtractoR: LEts Go Swimrun!" /></div>
      <div class="tiger-stripes"></div>
    </header>
    <slot />
    <script>import "../client/language-switch.ts";</script>
    <footer class="mx-auto max-w-7xl px-4 pb-8 text-xs text-stone-600">
      &copy; 2026 IT Off the Wall BV · <a class="underline" href={`${base}about.html`}>About</a>
      · Map data &copy; <a class="underline" href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>
      · Map by <a class="underline" href="https://leafletjs.com">Leaflet</a>
      · <a class="underline" href={`${base}guidebook.html`}>Guidebook</a>
    </footer>
  </body>
</html>
