---
import SiteLayout from "../layouts/SiteLayout.astro";
import en from "../data/pricing.en.json";
import nl from "../data/pricing.nl.json";
import fr from "../data/pricing.fr.json";
import de from "../data/pricing.de.json";

// The texts are data (src/data/pricing.<language>.json), not inline: one file per language.
const pages = { en, nl, fr, de };
const tiers = ["free", "silver", "gold", "platinum"] as const;
// A feature that is not paid is for everyone; a paid one is for the three membership tiers only.
const cell = (row: { paid: boolean; planned: boolean }, tier: (typeof tiers)[number], t: typeof en) =>
  row.paid ? (tier === "free" ? t.no : row.planned ? t.yesPlanned : t.yes) : t.yes;
---
<SiteLayout title="Pricing – TigerLegs" description="TigerLegs is under development and free for now; segment extraction is always free." active="pricing">
  <main class="mx-auto max-w-3xl space-y-6 px-4 py-8 leading-relaxed">
    {Object.entries(pages).map(([code, t]) => (
      <div lang={code} class="space-y-6">
        <h1 class="font-display text-4xl uppercase tracking-wider">{t.title} <span class="rounded bg-stone-950 px-2 py-0.5 align-middle text-xs font-semibold uppercase tracking-wider text-amber-400">Prototype</span></h1>
        <p data-prototype class="rounded border-2 border-stone-900 bg-amber-50 p-3 text-sm">{t.prototype}</p>
        <section class="space-y-2">
          <h2 class="text-xl font-bold">{t.statusTitle}</h2>
          <p data-status>{t.status}</p>
        </section>
        <section class="space-y-2 rounded border-2 border-stone-900 bg-white p-4">
          <h2 class="text-xl font-bold">{t.freeTitle}</h2>
          <p data-always-free>{t.free}</p>
        </section>
        <section class="space-y-2">
          <h2 class="text-xl font-bold">{t.tigerTitle}</h2>
          <p data-tigers>{t.tiger}</p>
        </section>
        <section class="space-y-2">
          <h2 class="text-xl font-bold">{t.tableTitle}</h2>
          <div class="overflow-x-auto">
            <table data-feature-table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-amber-100 text-left">
                  <th scope="col" class="border border-stone-300 p-2">{t.columns.feature}</th>
                  {tiers.map(tier => <th scope="col" class="border border-stone-300 p-2">{t.columns[tier]}</th>)}
                </tr>
              </thead>
              <tbody>
                {t.rows.map(row => (
                  <tr>
                    <th scope="row" class="border border-stone-300 p-2 text-left font-medium">{row.feature}</th>
                    {tiers.map(tier => <td class="border border-stone-300 p-2">{cell(row, tier, t)}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
        <section class="space-y-2" aria-labelledby={`references-${code}`}>
          <h2 id={`references-${code}`} class="text-lg font-bold">{t.referencesTitle}</h2>
          <ul data-references class="space-y-1 text-sm">
            {t.references.map(reference => (
              <li>
                <span set:html={reference.text.replace(/\*([^*]+)\*/g, "<em>$1</em>")} />{" "}
                <a class="underline" href={reference.url}>{reference.url}</a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    ))}
  </main>
</SiteLayout>
