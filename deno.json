{
  "name": "@swimrun/tigerlegs",
  "version": "0.2.0",
  "exports": "./mod.ts",
  "tasks": {
    "build": "deno task build:js && deno task build:docs && deno task build:samples && deno task build:css && ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/bin/astro.mjs build",
    "build:samples": "deno run --allow-read=test-data --allow-write=public/samples src/build-samples.ts",
    "build:docs": "deno run --allow-read=docs,assets --allow-write=public src/build-docs.ts",
    "diagrams": "plantuml -tsvg docs/diagrams/*.puml",
    "build:js": "deno bundle --platform browser --output public/analysis-worker.js src/client/analysis-worker.ts",
    "dev:site": "ASTRO_TELEMETRY_DISABLED=1 node node_modules/astro/bin/astro.mjs dev --port 8123",
    "build:css": "deno run -A npm:@tailwindcss/cli -i src/client/styles.css -o public/styles.css --minify",
    "dev": "deno task build:js && deno task build:docs && deno task build:samples && deno task build:css && deno task dev:site",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "@xmldom/xmldom": "npm:@xmldom/xmldom@^0.9",
    "marked": "npm:marked@^15",
    "fast-check": "npm:fast-check@^3.22.0",
    "@std/assert": "jsr:@std/assert@^1",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  }
}
