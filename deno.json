{
  "name": "@swimrun/tigerlegs",
  "version": "0.0.1",
  "exports": "./mod.ts",
  "tasks": {
    "build": "deno task build:js && deno task build:css",
    "build:js": "deno bundle --platform browser --output public/app.js src/client/app.ts",
    "build:css": "deno run -A npm:@tailwindcss/cli -i src/client/styles.css -o public/styles.css --minify",
    "dev": "deno task build && deno run --allow-net --allow-read --allow-write --allow-env src/main.ts",
    "test": "deno test -A",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@^4.3.3",
    "@xmldom/xmldom": "npm:@xmldom/xmldom@^0.9",
    "fast-check": "npm:fast-check@^3.22.0",
    "@std/assert": "jsr:@std/assert@^1",
    "tailwindcss": "npm:tailwindcss@^4.3.3"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  }
}
